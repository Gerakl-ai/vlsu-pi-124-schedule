{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vlsu-pi-124-schedule",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-28",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/vlsu-api/*",
      "/app-api/*"
    ]
  }
}
